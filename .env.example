# Strava API — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Deve ser idêntico ao cadastrado no app Strava (inclui porta e path)
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Cookie iron-session — mínimo 32 caracteres em produção
SESSION_SECRET=

# Opcional: URL canônica (domínio custom na Vercel). Se vazio, usa VERCEL_URL em produção.
# NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app
