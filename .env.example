# Strava API — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Produção (usectt.com.br): defina a URL completa do callback, idêntica no Strava (Authorize + Token).
# Authorization Callback Domain no painel Strava = só o host (ex.: www.usectt.com.br).
# STRAVA_REDIRECT_URI=https://www.usectt.com.br/api/auth/strava/callback

# Opcional. Se vazio, o app usa: {origem}/api/auth/strava/callback
# Origem = NEXT_PUBLIC_APP_URL, senão origem derivada de STRAVA_REDIRECT_URI, senão VERCEL_URL, senão localhost.
STRAVA_REDIRECT_URI=

# Cookie iron-session — mínimo 32 caracteres em produção
SESSION_SECRET=

# Produção: URL pública do site (com www se for o que o DNS aponta). Evita redirects OAuth no host errado.
# NEXT_PUBLIC_APP_URL=https://www.usectt.com.br

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Service role: somente server (sync/webhooks/cron). Nunca exponha no client.
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
