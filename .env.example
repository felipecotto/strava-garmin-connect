# Strava API — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Produção (Vercel): URL pública do site. Em `npm run dev` é ignorada — usa localhost.
# NEXT_PUBLIC_APP_URL=https://www.usectt.com.br

# Produção: callback canônico. Em development o app usa http://localhost:3000/api/auth/strava/callback.
# No painel Strava, Authorization Callback Domain = localhost (dev) ou usectt.com.br (prod).
# Apps locais e de produção costumam precisar de dois apps Strava, ou trocar o domain ao testar.
# STRAVA_REDIRECT_URI=https://www.usectt.com.br/api/auth/strava/callback

# Opcional. Se vazio em produção, o app usa: {origem}/api/auth/strava/callback
STRAVA_REDIRECT_URI=

# Cookie iron-session — mínimo 32 caracteres em produção
SESSION_SECRET=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Service role: somente server (sync/webhooks/cron). Nunca exponha no client.
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
