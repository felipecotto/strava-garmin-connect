# Strava API — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Opcional. Se vazio, o app usa: {origem}/api/auth/strava/callback
# (origem = NEXT_PUBLIC_APP_URL, ou VERCEL_URL na Vercel, ou localhost em dev).
# Se preencher, deve ser IDÊNTICO ao fluxo OAuth (authorize + token).
# No Strava, "Authorization Callback Domain" = só o host (ex.: projeto.vercel.app ou localhost:3000).
STRAVA_REDIRECT_URI=

# Cookie iron-session — mínimo 32 caracteres em produção
SESSION_SECRET=

# Opcional: URL canônica (domínio custom na Vercel). Se vazio, usa VERCEL_URL em produção.
# NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app
